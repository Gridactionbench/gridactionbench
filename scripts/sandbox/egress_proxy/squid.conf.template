# Allowlisting forward proxy config for the GridActionBench agent sandbox.
# See docs/architecture/adr/ADR-019-agent-execution-sandbox.md and
# scripts/sandbox/README.md. Generated from this template by
# scripts/sandbox/provision_network.sh, which fills in ALLOWED_HOSTS from the run's
# declared model-provider hostname(s) — never a default-open list.
#
# Squid is used purely as a CONNECT-tunneling allowlist (dstdomain ACL) — it never
# terminates/inspects TLS (no SslBump, no certificate injected into the agent
# container), so an agent's traffic to an allowed host stays end-to-end encrypted to
# that host exactly as if there were no proxy. The allowlist operates on the CONNECT
# target hostname only.

http_port 3128

acl allowed_hosts dstdomain ALLOWED_HOSTS_PLACEHOLDER

# Only CONNECT (HTTPS) to an allowed host is ever permitted. Plain HTTP is not
# forwarded at all (no "acl ... port 80" rule) — the agent sandbox is expected to talk
# to model-provider APIs, which are HTTPS-only.
acl CONNECT method CONNECT
http_access allow CONNECT allowed_hosts
http_access deny CONNECT
http_access deny all

# Default-deny log format (full req line) so a denied CONNECT's target host is
# recoverable later via `docker logs <proxy_container>` — this is exactly what
# gridactionbench/agents/docker_backend.py's `_parse_squid_denied_hosts` reads.
access_log stdio:/dev/stdout squid

# No disk cache — this proxy only ever tunnels CONNECT, it never caches response
# bodies (and couldn't, since it never sees them — TLS stays end-to-end).
cache deny all
